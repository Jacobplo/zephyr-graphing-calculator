                <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>, <&gpio0 21 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
                <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>, <&gpio0 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
                <&gpio0 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
  };
